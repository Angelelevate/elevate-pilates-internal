NODE_ENV=development
PORT=3001
# No trailing slash (must match browser Origin for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Used in invite emails and absolute links (defaults to CLIENT_ORIGIN)
FRONTEND_URL=http://localhost:5173

# Optional: path to Firebase service account JSON (never commit the file)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional: override default Storage bucket (default is {project_id}.appspot.com from the service account)
# FIREBASE_STORAGE_BUCKET=

# Web API key from Firebase console — enables POST /api/profile/change-password
FIREBASE_WEB_API_KEY=

# Used for full system config (admin) and server-side checks; not exposed on /config/public
MAINTENANCE_MODE=false

# Optional overrides
# INVITE_EXPIRY_DAYS=7
# MAX_VIDEO_UPLOAD_BYTES=524288000
