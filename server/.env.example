NODE_ENV=development
PORT=3001
# No trailing slash (must match browser Origin for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Used in invite emails and absolute links (defaults to CLIENT_ORIGIN)
FRONTEND_URL=http://localhost:5173

# Optional: path to Firebase service account JSON (never commit the file)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional: override Storage bucket. Many Firebase projects use {project_id}.firebasestorage.app
# (check Firebase Console → Storage). Legacy default from the service account is {project_id}.appspot.com.
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Web API key from Firebase console — enables POST /api/profile/change-password
FIREBASE_WEB_API_KEY=

# Used for full system config (admin) and server-side checks; not exposed on /config/public
MAINTENANCE_MODE=false

# Optional overrides
# INVITE_EXPIRY_DAYS=7
# MAX_VIDEO_UPLOAD_BYTES=524288000

# Password reset emails use Firebase Auth templates. In Firebase Console → Authentication → Templates,
# set the sender name, subject, and body so users see your product name (not the raw project ID).

# Large videos: the admin UI PUTs files straight to Cloud Storage (signed URL). Your bucket needs CORS
# allowing PUT (and often GET/HEAD) from your app origins, e.g.:
#   gsutil cors set cors.json gs://YOUR_BUCKET_NAME
# cors.json example:
# [{"origin":["http://localhost:5173","https://your-production-domain.com"],"method":["PUT","GET","HEAD"],"responseHeader":["Content-Type","x-goog-resumable"],"maxAgeSeconds":3600}]
